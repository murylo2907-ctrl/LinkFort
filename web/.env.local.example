# Copie este arquivo para .env.local e preencha com suas chaves reais.
# O .env.local NUNCA deve ser commitado (já está no .gitignore).

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → anon public (NÃO usar service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp → número com DDI e DDD, sem + ou espaços (ex.: 554130263491)
NEXT_PUBLIC_WHATSAPP_NUMBER=554130263491

# Mercado Pago → Developers → Suas integrações → Credenciais de teste → Access Token
MERCADOPAGO_ACCESS_TOKEN=
